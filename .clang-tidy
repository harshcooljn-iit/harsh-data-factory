# FlowForge static-analysis configuration.
#
# Scope is deliberately practical: correctness / bug-prone checks plus a light
# modernize/readability pass. Noisy or opinionated checks that fight day-to-day
# systems code are disabled rather than blanket-suppressed in source.
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  misc-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  modernize-loop-convert,
  modernize-use-default-member-init,
  performance-*,
  readability-braces-around-statements,
  readability-const-return-type,
  readability-redundant-member-init,
  readability-simplify-boolean-expr,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -misc-include-cleaner,
  -performance-avoid-endl

WarningsAsErrors: ''
HeaderFilterRegex: 'include/flowforge/.*'
FormatStyle: file
