# FlowForge static-analysis configuration.
#
# Scope is deliberately practical: correctness / bug-prone checks plus a light
# modernize/readability pass. Checks that fight day-to-day systems code with a
# high false-positive rate (const-correctness on every lock_guard,
# exception-escape on noexcept helpers that call standard-library code,
# signed-bitwise on hash constants, ...) are turned off here rather than
# suppressed line-by-line in source.
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-slicing,
  misc-definitions-in-headers,
  misc-misplaced-const,
  misc-redundant-expression,
  misc-static-assert,
  misc-unused-alias-decls,
  misc-unused-using-decls,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  modernize-loop-convert,
  modernize-use-default-member-init,
  modernize-use-emplace,
  performance-for-range-copy,
  performance-implicit-conversion-in-loop,
  performance-inefficient-vector-operation,
  performance-move-const-arg,
  performance-unnecessary-value-param,
  readability-braces-around-statements,
  readability-simplify-boolean-expr,
  -bugprone-easily-swappable-parameters,
  -bugprone-empty-catch,
  -bugprone-exception-escape,
  -bugprone-narrowing-conversions,
  -bugprone-signed-bitwise,
  -bugprone-unchecked-optional-access

WarningsAsErrors: ''
HeaderFilterRegex: 'include/flowforge/.*'
FormatStyle: file
